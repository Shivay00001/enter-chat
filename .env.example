# ============================================================
# EnterChat Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env
# ============================================================

# --- General ---
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000
WS_PORT=3001

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=enterchat
DB_USER=enterchat
DB_PASSWORD=CHANGE_ME_IN_PRODUCTION
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- JWT ---
JWT_SECRET=CHANGE_ME_USE_MINIMUM_256_BIT_SECRET
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=30d
JWT_ISSUER=enterchat

# --- OTP ---
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
# SMS provider: stub | twilio | aws_sns
OTP_SMS_PROVIDER=stub
# Twilio (only if OTP_SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_OTP_START_MAX=5
RATE_LIMIT_OTP_VERIFY_MAX=10

# --- Media / Object Storage ---
# Provider: local | s3 | r2
MEDIA_STORAGE_PROVIDER=local
MEDIA_LOCAL_PATH=./uploads
MEDIA_MAX_FILE_SIZE_MB=100
# S3/R2 (only if MEDIA_STORAGE_PROVIDER=s3 or r2)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- Push Notifications ---
# Provider: stub | fcm | apns
PUSH_PROVIDER=stub
# Firebase Cloud Messaging (only if PUSH_PROVIDER=fcm)
FCM_SERVICE_ACCOUNT_KEY=
# Apple Push (only if PUSH_PROVIDER=apns)
APNS_KEY_ID=
APNS_TEAM_ID=

# --- CORS ---
CORS_ORIGIN=http://localhost:3000

# --- WebSocket ---
WS_HEARTBEAT_INTERVAL_MS=30000
WS_HEARTBEAT_TIMEOUT_MS=60000
WS_MAX_CONNECTIONS_PER_USER=5

# --- Message Limits ---
MESSAGE_MAX_LENGTH=10000
MESSAGE_MAX_MEDIA_ATTACHMENTS=10

# --- Payment Gateway ---
# Provider: stub | razorpay | stripe
PAYMENT_PROVIDER=stub
# Razorpay (India — UPI + Cards + Netbanking)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Stripe (International — Cards + PayPal)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Subscriptions ---
SUBSCRIPTION_FREE_DEVICE_LIMIT=1
SUBSCRIPTION_PREMIUM_MONTHLY_INR=9900
SUBSCRIPTION_PREMIUM_MONTHLY_USD=299

# --- Flutter API Config (used in Flutter app) ---
API_BASE_URL=http://10.0.2.2:3000
WS_BASE_URL=ws://10.0.2.2:3001
