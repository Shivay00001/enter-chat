# =============================================
# EnterChat Production Environment Configuration
# =============================================
# Copy this to .env on your production server.
# NEVER commit production values to git.
# =============================================

# --- General ---
NODE_ENV=production
LOG_LEVEL=info
PORT=3000
WS_PORT=3001

# --- Domain Mapping ---
APP_DOMAIN=enterchat.app
API_DOMAIN=api.enterchat.app
WS_DOMAIN=ws.enterchat.app
WEB_DOMAIN=www.enterchat.app

# --- PostgreSQL ---
DB_HOST=db
DB_PORT=5432
DB_NAME=enterchat
DB_USER=enterchat
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DB_SSL=false
DB_POOL_MIN=5
DB_POOL_MAX=20

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0

# --- JWT ---
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_SECRET=CHANGE_ME_MIN_64_CHARS_RANDOM_STRING
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=30d
JWT_ISSUER=enterchat

# --- OTP ---
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_SMS_PROVIDER=twilio
# OTP_SMS_PROVIDER=aws_sns

# --- Twilio (if OTP_SMS_PROVIDER=twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_OTP_START_MAX=5
RATE_LIMIT_OTP_VERIFY_MAX=10

# --- Media / Object Storage ---
MEDIA_STORAGE_PROVIDER=s3
MEDIA_MAX_FILE_SIZE_MB=100
AWS_S3_BUCKET=enterchat-media
AWS_S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Or use Cloudflare R2:
# MEDIA_STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=enterchat-media

# --- CORS ---
CORS_ORIGIN=https://enterchat.app

# --- WebSocket ---
WS_HEARTBEAT_INTERVAL_MS=30000
WS_HEARTBEAT_TIMEOUT_MS=60000
WS_MAX_CONNECTIONS_PER_USER=5

# --- Message Limits ---
MESSAGE_MAX_LENGTH=10000
MESSAGE_MAX_MEDIA_ATTACHMENTS=10

# --- Push Notifications (FCM) ---
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_KEY=

# --- APNs (Apple Push) ---
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=app.enterchat
