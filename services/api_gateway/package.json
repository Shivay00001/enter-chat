{
  "name": "@enterchat/api-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "EnterChat API Gateway — REST + WebSocket",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
